# Loaded by `vite build --mode native` (npm run build:native) for the Android
# and iOS apps. The WebView's own origin is https://localhost /
# capacitor://localhost, so /api/* calls and shared links must point at the
# deployed site. Not a secret; the web build never reads this file.
VITE_API_BASE=https://wheretopark.sg

# Google sign-in (lib/nativeAuth.ts). Public OAuth client ids from Google
# Cloud project 26992432747: the Web client (Android's Credential Manager and
# the server's audience check need it) and the iOS client. The reversed iOS id
# is also the GOOGLE_REVERSED_CLIENT_ID build setting in ios/App/App.xcodeproj.
VITE_GOOGLE_CLIENT_ID=26992432747-26a2hc9vv25gkml43r4hd2lr310rl4te.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=26992432747-828f7ld9tg3fve6vfrmqtsp5fm77jslu.apps.googleusercontent.com
