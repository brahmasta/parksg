{
  "$name": "wheretopark.sg",
  "$description": "Design tokens for wheretopark.sg. Source of truth: src/index.css. Every colour is resolved to a concrete value here — the web source uses color-mix() and rgba(), which Android cannot read. Contrast ratios under `wcag` are measured against the surface the token actually sits on.",
  "$version": "1.0.0",
  "$generated": "2026-09-19",

  "font": {
    "display": { "family": "Plus Jakarta Sans", "fallback": "Helvetica Neue, system-ui, sans-serif", "googleFonts": true },
    "body": { "family": "Plus Jakarta Sans", "fallback": "Helvetica Neue, system-ui, sans-serif", "googleFonts": true },
    "mono": {
      "family": "Plus Jakarta Sans",
      "fallback": "Helvetica Neue, system-ui, sans-serif",
      "googleFonts": true,
      "note": "Deliberately NOT a monospace face. 'mono' is a ROLE, not a family: small, uppercase, letter-spaced metadata labels. All numerals render with tabular figures (font-feature 'tnum')."
    },
    "brand": {
      "family": "Space Grotesk",
      "fallback": "Helvetica Neue, system-ui, sans-serif",
      "googleFonts": true,
      "note": "Logo and wordmark ONLY. Never used for UI text."
    },
    "weights": [400, 500, 600, 700, 800]
  },

  "brand": {
    "$note": "Logo only. Deliberately NOT the UI accent — never use for buttons, links or selection states.",
    "brand": "#2EE3C2",
    "brand2": "#14C9B6",
    "brandOn": "#0B2E2A",
    "brandGlow": "#2EE3C273",
    "tileGradient": { "type": "linear", "angleDeg": 145, "stops": ["#2EE3C2", "#14C9B6"] }
  },

  "themePreference": {
    "$note": "FOUR preferences resolve to THREE palettes. The preference is what the visitor picks and what you persist; the palette is what you paint. Keep these separate — conflating them is the usual bug.",
    "default": "auto",
    "storageKey": "psg:theme",
    "autoResolvesTo": {
      "deviceDark": "dark",
      "otherwise": "sunlight",
      "$note": "NOT 'light'. Someone who has expressed no preference is better served by the readable palette, so auto's light branch is Sunlight."
    },
    "live": "Auto tracks the OS setting continuously — flipping the device theme repaints immediately, with no reload and no app restart.",
    "options": [
      { "id": "auto", "label": "Auto", "blurb": "Follows your device — dark at night if your phone is set that way.", "icon": "ic_device" },
      { "id": "sunlight", "label": "Sunlight", "blurb": "Highest contrast — stays readable in direct sun.", "icon": "ic_contrast" },
      { "id": "light", "label": "Standard", "blurb": "The softer light theme. Easier on the eyes indoors.", "icon": "ic_sun" },
      { "id": "dark", "label": "Dark", "blurb": "Near-black. Less glare at night.", "icon": "ic_moon" }
    ]
  },

  "themes": {
    "sunlight": {
      "$label": "Sunlight",
      "$blurb": "Highest contrast — stays readable in direct sun.",
      "$default": false,
      "$autoLightBranch": true,
      "$note": "The default PREFERENCE is 'auto', not this palette. Auto paints Sunlight whenever the device is not in dark mode, so this is still what most visitors see.",
      "$isDark": false,
      "$statusBar": "#EEF1F5",
      "$rationale": "Built for a phone held at arm's length in Singapore daylight. A grey page ground so white cards read as objects; every text tier and status colour clears WCAG AA 4.5:1; borders and shadows strong enough that a hairline still shows outdoors.",
      "color": {
        "bg0": { "value": "#EEF1F5", "use": "Page ground behind cards. 1.13:1 against a white card — intentional; it is what makes cards read as objects." },
        "bg1": { "value": "#FFFFFF", "use": "Card / sheet / elevated surface." },
        "bg2": { "value": "#E4E9F1", "use": "Inset fields (search box), recessed wells." },
        "bg3": { "value": "#DBE2EC", "use": "Chips, badges, icon tiles." },
        "line": { "value": "#9AA4B5", "use": "Hairline dividers and card edges (0.5dp).", "wcag": "2.5:1 on bg1" },
        "lineStrong": { "value": "#7D8798", "use": "Control outlines — inputs, chips, buttons.", "wcag": "3.6:1 on bg1 — meets WCAG 1.4.11" },
        "text1": { "value": "#141A22", "use": "Primary text, hero numbers.", "wcag": "16.6:1" },
        "text2": { "value": "#4A5768", "use": "Secondary text, supporting labels.", "wcag": "7.4:1" },
        "text3": { "value": "#5F6D80", "use": "Tertiary — addresses, source lines, placeholders, eyebrow labels.", "wcag": "5.3:1" },
        "ok": { "value": "#036347", "use": "Available lots.", "wcag": "7.3:1" },
        "okBg": { "value": "#D8F0E6" },
        "warn": { "value": "#7A4E00", "use": "Limited lots, stale-data warnings.", "wcag": "7.2:1" },
        "warnBg": { "value": "#FBEACB" },
        "bad": { "value": "#B00020", "use": "Full / error.", "wcag": "7.3:1" },
        "badBg": { "value": "#FBDDE1" },
        "mutedStatus": { "value": "#3A4657", "use": "Unknown availability." },
        "mutedStatusBg": { "value": "#DDE4EE" },
        "accent": { "value": "#0B5C55", "use": "Functional accent — primary buttons, selected chips, links, focus ring.", "wcag": "7.9:1 as text; white on it is 7.9:1" },
        "accentOn": { "value": "#FFFFFF", "use": "Foreground on accent fill." },
        "accentTint": { "value": "#E4EDEC", "use": "accent 11% over bg1 — icon tiles, soft fills." },
        "accentTintStrong": { "value": "#CEDEDD", "use": "accent 20% over bg1 — selected chip fill, toast icon tile." },
        "accentBlue": { "value": "#3636C9", "use": "Links / info highlights.", "wcag": "8.3:1" },
        "accentBlueBg": { "value": "#E2E2FB" },
        "glass": { "value": "#FFFFFF", "alpha": 0.94, "argb": "#F0FFFFFF", "use": "Chips floating over the walk map. Near-solid outdoors." },
        "srcHdb": { "value": "#0B5C55" },
        "srcUra": { "value": "#3636C9" },
        "srcLta": { "value": "#7A4E00" },
        "srcEv": { "value": "#6A10BD" }
      },
      "shadow": {
        "sm": { "y": 1, "blur": 2, "color": "#141E3C", "alpha": 0.1, "elevationDp": 1 },
        "card": { "y": 2, "blur": 6, "color": "#141E3C", "alpha": 0.14, "elevationDp": 3 },
        "raised": { "y": 10, "blur": 24, "color": "#141E3C", "alpha": 0.22, "elevationDp": 10 },
        "modal": { "y": 20, "blur": 44, "color": "#141E3C", "alpha": 0.32, "elevationDp": 20 }
      }
    },

    "light": {
      "$label": "Standard",
      "$blurb": "The softer light theme. Easier on the eyes indoors.",
      "$default": false,
      "$isDark": false,
      "$a11yWarning": "This is the ORIGINAL soft palette, kept as an opt-in preference. text3 (2.96:1), ok (3.42:1), warn (3.40:1), accent (3.74:1) and bad (4.46:1) are below WCAG AA on bg1, and lineStrong is 1.56:1 against a 3:1 requirement. Sunlight exists because of exactly these numbers. Offer Standard as a user choice; never make it the default and never treat it as an accessible baseline. Verify with tools/check-contrast.mjs.",
      "$statusBar": "#FAFAFA",
      "color": {
        "bg0": { "value": "#FAFAFA" },
        "bg1": { "value": "#FFFFFF" },
        "bg2": { "value": "#F5F7F9" },
        "bg3": { "value": "#EEF2F8" },
        "line": { "value": "#E9EFF7" },
        "lineStrong": { "value": "#C1D0E5" },
        "text1": { "value": "#242A33" },
        "text2": { "value": "#58677D" },
        "text3": { "value": "#8A97AA" },
        "ok": { "value": "#0E9E6E" },
        "okBg": { "value": "#E2F7EF" },
        "warn": { "value": "#B8810F" },
        "warnBg": { "value": "#FEF1DC" },
        "bad": { "value": "#EC113A" },
        "badBg": { "value": "#FBE0E5" },
        "mutedStatus": { "value": "#58677D" },
        "mutedStatusBg": { "value": "#EEF2F8" },
        "accent": { "value": "#0D9488" },
        "accentOn": { "value": "#FFFFFF" },
        "accentTint": { "value": "#E4F3F2" },
        "accentTintStrong": { "value": "#CFEAE7" },
        "accentBlue": { "value": "#5050FA" },
        "accentBlueBg": { "value": "#ECECFE" },
        "glass": { "value": "#FFFFFF", "alpha": 0.82, "argb": "#D1FFFFFF" },
        "srcHdb": { "value": "#0D9488" },
        "srcUra": { "value": "#5050FA" },
        "srcLta": { "value": "#FCAE30" },
        "srcEv": { "value": "#921FFF" }
      },
      "shadow": {
        "sm": { "y": 1, "blur": 2, "color": "#1C274C", "alpha": 0.05, "elevationDp": 1 },
        "card": { "y": 2, "blur": 8, "color": "#1C274C", "alpha": 0.06, "elevationDp": 3 },
        "raised": { "y": 10, "blur": 28, "color": "#1C274C", "alpha": 0.12, "elevationDp": 10 },
        "modal": { "y": 20, "blur": 50, "color": "#1C274C", "alpha": 0.2, "elevationDp": 20 }
      }
    },

    "dark": {
      "$label": "Dark",
      "$blurb": "Near-black. Less glare at night.",
      "$default": false,
      "$isDark": true,
      "$statusBar": "#12151A",
      "color": {
        "bg0": { "value": "#12151A" },
        "bg1": { "value": "#1A1E25" },
        "bg2": { "value": "#20252E" },
        "bg3": { "value": "#2A313C" },
        "line": { "value": "#FFFFFF", "alpha": 0.14, "argb": "#24FFFFFF" },
        "lineStrong": { "value": "#FFFFFF", "alpha": 0.34, "argb": "#57FFFFFF", "wcag": "3.0:1 on bg1" },
        "text1": { "value": "#F5F7FA" },
        "text2": { "value": "#F5F7FA", "alpha": 0.66, "argb": "#A8F5F7FA", "wcag": "7.4:1" },
        "text3": { "value": "#F5F7FA", "alpha": 0.52, "argb": "#85F5F7FA", "wcag": "5.2:1" },
        "ok": { "value": "#25D092" },
        "okBg": { "value": "#25D092", "alpha": 0.15, "argb": "#2625D092" },
        "warn": { "value": "#FCAE30" },
        "warnBg": { "value": "#FCAE30", "alpha": 0.16, "argb": "#29FCAE30" },
        "bad": { "value": "#FF5A6E" },
        "badBg": { "value": "#FF5A6E", "alpha": 0.15, "argb": "#26FF5A6E" },
        "mutedStatus": { "value": "#8A97AA" },
        "mutedStatusBg": { "value": "#8A97AA", "alpha": 0.16, "argb": "#298A97AA" },
        "accent": { "value": "#2DD4BF" },
        "accentOn": { "value": "#062925" },
        "accentTint": { "value": "#1C3236" },
        "accentTintStrong": { "value": "#1E4244" },
        "accentBlue": { "value": "#5050FA", "a11yWarning": "3.08:1 on bg1 — below AA. Carried over from the light palette without being retuned for a near-black surface. Lighten it before using it for link text in dark mode." },
        "accentBlueBg": { "value": "#ECECFE", "a11yWarning": "A light-theme tint, unchanged for dark. Retune if used as a surface here." },
        "glass": { "value": "#1A1E25", "alpha": 0.82, "argb": "#D11A1E25" },
        "srcHdb": { "value": "#2DD4BF" },
        "srcUra": { "value": "#5050FA" },
        "srcLta": { "value": "#FCAE30" },
        "srcEv": { "value": "#921FFF" }
      },
      "shadow": {
        "sm": { "y": 1, "blur": 2, "color": "#1C274C", "alpha": 0.05, "elevationDp": 1 },
        "card": { "y": 2, "blur": 8, "color": "#1C274C", "alpha": 0.06, "elevationDp": 3 },
        "raised": { "y": 10, "blur": 28, "color": "#1C274C", "alpha": 0.12, "elevationDp": 10 },
        "modal": { "y": 20, "blur": 50, "color": "#1C274C", "alpha": 0.2, "elevationDp": 20 }
      }
    }
  },

  "radius": {
    "$note": "Derived from usage frequency across the web app. 999 = fully rounded pill.",
    "xs": 4,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 14,
    "xxl": 16,
    "sheet": 22,
    "pill": 999
  },

  "spacing": {
    "$note": "4dp base grid. gap:8 and gap:12 carry most of the layout.",
    "xxs": 2,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 20,
    "xxxl": 24,
    "screenGutter": 16
  },

  "type": {
    "$note": "Sizes are sp. Half-point sizes are intentional — the ladder was tuned optically, not generated. lineHeight is a multiplier where given.",
    "hero": { "size": 32, "weight": 700, "letterSpacing": -1.0, "lineHeight": 1.0, "use": "Admin hero figure." },
    "costHero": { "size": 28, "weight": 600, "letterSpacing": -0.6, "lineHeight": 1.0, "use": "Price on a result card — the single most important number in the product." },
    "total": { "size": 26, "weight": 700, "letterSpacing": -0.6, "lineHeight": 1.0 },
    "metric": { "size": 22, "weight": 700, "letterSpacing": -0.5, "lineHeight": 1.0 },
    "screenTitle": { "size": 20, "weight": 700, "letterSpacing": -0.4 },
    "wordmark": { "size": 19, "weight": 700, "letterSpacing": -0.4, "font": "brand" },
    "cardTitle": { "size": 17, "weight": 600, "letterSpacing": -0.1, "lineHeight": 1.15, "use": "Carpark name." },
    "input": { "size": 16, "weight": 400, "letterSpacing": -0.1, "use": "16sp floor on inputs — smaller reads poorly in sun." },
    "bodyLg": { "size": 15, "weight": 400 },
    "body": { "size": 14, "weight": 400 },
    "bodySm": { "size": 13.5, "weight": 500, "use": "Toast title, active chip label." },
    "label": { "size": 13, "weight": 500 },
    "caption": { "size": 12.5, "weight": 500, "use": "The workhorse — walk time, lot counts, card metadata." },
    "captionSm": { "size": 12, "weight": 400 },
    "micro": { "size": 11.5, "weight": 500, "use": "Filter pill label." },
    "eyebrow": { "size": 10.5, "weight": 600, "letterSpacing": 1.0, "allCaps": true, "font": "mono", "use": "Section labels — always text3." },
    "badge": { "size": 10, "weight": 500, "letterSpacing": 0.6, "font": "mono", "use": "Operator badge, EV chip, rank." },
    "badgeTiny": { "size": 9.5, "weight": 600, "letterSpacing": 0.6, "allCaps": true, "font": "mono", "use": "CHEAPEST pill, 2018 RATE pill." }
  },

  "motion": {
    "$note": "One easing curve carries the whole product. Honour the OS reduce-motion setting: skip the animation, never the end state.",
    "easing": { "standard": [0.22, 1.0, 0.36, 1.0], "$name": "easeOutQuint-like", "linear": [0, 0, 1, 1] },
    "duration": {
      "micro": 120,
      "fast": 140,
      "quick": 160,
      "sheetFade": 180,
      "screenIn": 220,
      "toastIn": 220,
      "listItem": 280,
      "sheetUp": 260,
      "pulse": 1600,
      "spin": 900
    },
    "staggerStepMs": 40,
    "staggerFirstDelayMs": 20,
    "staggerMaxChildren": 7,
    "listItemEnter": {
      "$note": "Transform-only. Never animate opacity for list entry — a paused timeline can leave content permanently invisible.",
      "fromTranslateY": 12,
      "toTranslateY": 0
    },
    "screenEnter": { "fromTranslateY": 8, "toTranslateY": 0 }
  },

  "a11y": {
    "minTouchTargetDp": 44,
    "focusRing": { "widthDp": 2, "offsetDp": 2, "color": "accent" },
    "contrastFloor": "4.5:1 for all text; 3:1 for control outlines (WCAG 1.4.11)",
    "tabularNumerals": "Every numeral in the app uses tabular figures so counts and prices do not jitter between refreshes."
  }
}
