{
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/carpark/:slug", "destination": "/api/carpark?slug=:slug" },
    { "source": "/parking-near/:area", "destination": "/api/parking-near?area=:area" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "header", "key": "origin", "value": "capacitor://localhost" }],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "capacitor://localhost" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "header", "key": "origin", "value": "https://localhost" }],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://localhost" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ura-rates-ingest",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/prune-app-events",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/data-health",
      "schedule": "0 20 * * *"
    }
  ]
}
